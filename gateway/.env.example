INKMATE_DEVICE_SECRETS=inkmate-demo:replace-with-at-least-32-random-bytes
INKMATE_MAX_CLOCK_SKEW_SECONDS=300
# `faster-whisper` runs locally. The model downloads on the first gateway start.
INKMATE_STT_BACKEND=faster-whisper
INKMATE_STT_MODEL=base.en
INKMATE_TTS_URL=
INKMATE_OLLAMA_URL=http://host.docker.internal:11434
INKMATE_OLLAMA_MODEL=llama3.2
INKMATE_AUDIO_TTL_SECONDS=300
INKMATE_ACTION_TTL_SECONDS=60
INKMATE_SAFE_COMMANDS_JSON={}
INKMATE_ACTION_PHRASES_JSON={}
INKMATE_MAX_AUDIO_BYTES=4194304
INKMATE_DISCOVERY_PORT=37653
INKMATE_GATEWAY_PORT=8080
# `start-device-gateway.sh` derives this from INKMATE_GATEWAY_INTERFACE.
# Keep the interface name in local .env so a multi-LAN host always advertises
# the intended network. Do not put a LAN address in tracked configuration.
INKMATE_GATEWAY_INTERFACE=
INKMATE_BIND_ADDRESS=
INKMATE_GATEWAY_NETWORK=
INKMATE_WORKSPACE_ALLOWLIST=/workspaces/project-a,/workspaces/project-b
INKMATE_ENABLE_CODING_AGENTS=false
