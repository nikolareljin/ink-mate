# Bind to 127.0.0.1 by default. Use a trusted LAN address for device access.
INKMATE_BIND_ADDRESS=127.0.0.1
INKMATE_PORT=8080

# Comma-separated device-id:secret pairs. Generate at least 32 random bytes
# per secret. The development value shown here is intentionally unsafe.
INKMATE_DEVICE_SECRETS=inkmate-demo:replace-with-at-least-32-random-bytes
INKMATE_MAX_CLOCK_SKEW_SECONDS=300
INKMATE_STT_BACKEND=unavailable
INKMATE_STT_MODEL=small.en
INKMATE_TTS_URL=
INKMATE_AUDIO_TTL_SECONDS=300
INKMATE_ACTION_TTL_SECONDS=60
INKMATE_SAFE_COMMANDS_JSON={}
INKMATE_ACTION_PHRASES_JSON={}

# Docker Desktop uses host.docker.internal. Linux Compose adds a host-gateway map.
INKMATE_OLLAMA_URL=http://host.docker.internal:11434
INKMATE_OLLAMA_MODEL=replace-with-installed-model
INKMATE_LOG_TRANSCRIPTS=false

# Optional OpenAI-compatible fallback. Leave disabled unless configured.
INKMATE_CLOUD_ENABLED=false
OPENAI_API_KEY=
