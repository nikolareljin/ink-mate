# Bind to 127.0.0.1 by default. For device discovery, set the interface name
# below and let start-device-gateway.sh derive the current LAN address locally.
INKMATE_BIND_ADDRESS=127.0.0.1
INKMATE_PORT=8080
INKMATE_GATEWAY_INTERFACE=
INKMATE_GATEWAY_NETWORK=

# Private Wi-Fi credentials used only to generate ignored firmware configuration.
INKMATE_WIFI_SSID=example-wifi
INKMATE_WIFI_PASSWORD=example-password

# Comma-separated device-id:secret pairs. Generate at least 32 random bytes
# per secret. The development value shown here is intentionally unsafe.
INKMATE_DEVICE_SECRETS=inkmate-demo:replace-with-at-least-32-random-bytes
INKMATE_MAX_CLOCK_SKEW_SECONDS=300
# `faster-whisper` runs locally. The model downloads on the first gateway start.
INKMATE_STT_BACKEND=faster-whisper
INKMATE_STT_MODEL=base.en
INKMATE_TTS_URL=
INKMATE_AUDIO_TTL_SECONDS=300
INKMATE_ACTION_TTL_SECONDS=60
INKMATE_SAFE_COMMANDS_JSON={}
INKMATE_ACTION_PHRASES_JSON={}

# Docker Desktop uses host.docker.internal. Linux Compose adds a host-gateway map.
INKMATE_OLLAMA_URL=http://host.docker.internal:11434
INKMATE_OLLAMA_MODEL=replace-with-installed-model
INKMATE_LOG_TRANSCRIPTS=false

# Optional OpenAI-compatible fallback. Leave disabled unless configured.
INKMATE_CLOUD_ENABLED=false
OPENAI_API_KEY=
# Local work-item and GitHub issue configuration for v0.2.0.
# Each project path must resolve under INKMATE_WORK_ITEM_ROOT.
INKMATE_WORK_ITEM_ROOT=/srv/inkmate/projects
INKMATE_DEFAULT_PROJECT=inbox
INKMATE_PROJECTS_JSON={"inbox":"/srv/inkmate/projects/inbox"}
# Fine-grained token with Issues: Read and write only. Keep it local and ignored.
INKMATE_GITHUB_TOKEN=
INKMATE_GITHUB_API_URL=https://api.github.com
INKMATE_GITHUB_REPOSITORIES_JSON={"inbox":"owner/repository"}
INKMATE_GITHUB_LABELS_JSON={"inbox":["inkmate","voice-capture"]}
